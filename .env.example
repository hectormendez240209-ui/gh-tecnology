NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key
# Solo servidor (NUNCA con prefijo NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# Dropi (token de integración desde tu panel de Dropi)
DROPI_API_URL=https://api.dropi.co
DROPI_API_TOKEN=tu_token_dropi
DROPI_PRODUCTS_PATH=/integrations/products
DROPI_ORDERS_PATH=/integrations/orders/myorders
# Margen sobre el precio proveedor (1.30 = +30%)
DROPI_MARGIN=1.30

# Protege el endpoint de sincronización (Vercel Cron lo envía automáticamente)
CRON_SECRET=una_cadena_larga_aleatoria
